{
    "name": "@shirokasoke/webapi-sdk",
    "version": "2.9.0-beta3-0.17-pre2",
    "private": false,
    "description": "TypeScript SDK for the love.shirokasoke.WebAPI Minecraft Mod",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "tsx --test test/*.test.ts",
        "web": "npm run build && rm -rf /workspace/web/node_modules/@shirokasoke/webapi-sdk/dist && cp -r dist package.json /workspace/web/node_modules/@shirokasoke/webapi-sdk/"
    },
    "keywords": [
        "gtnh",
        "minecraft",
        "webapi",
        "mod",
        "sdk"
    ],
    "author": "Rcrwrate",
    "license": "MIT",
    "homepage": "https://github.com/Rcrwrate/McWebAPI/tree/main/sdk/ts",
    "devDependencies": {
        "@types/node": "^26.6.5",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@microsoft/fetch-event-source": "^2.0.1",
        "joi": "^18.3.0"
    }
}